# ROOMie Campus Nest Environment Configuration

# ============================================
# SUPABASE CONFIGURATION
# ============================================
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ============================================
# PAYMENT GATEWAY (PAYSTACK)
# ============================================
VITE_PAYSTACK_PUBLIC_KEY=your_paystack_public_key

# ============================================
# ERROR MONITORING (SENTRY)
# ============================================
# Get DSN from: Sentry Dashboard -> Settings -> Projects -> [Your Project] -> Client Keys (DSN)
VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Build-time only (for source map uploads) - DO NOT prefix with VITE_
# Get auth token from: Sentry Dashboard -> Settings -> Account -> Auth Tokens
SENTRY_AUTH_TOKEN=your_sentry_auth_token
SENTRY_ORG=your_sentry_org_slug
SENTRY_PROJECT=roomie

# ============================================
# TRANSACTIONAL EMAIL (RESEND)
# ============================================
# Get API key from: Resend Dashboard -> API Keys -> Create API Key
VITE_RESEND_API_KEY=re_your_api_key

# ============================================
# ANALYTICS (POSTHOG)
# ============================================
# VITE_POSTHOG_API_KEY=phc_your_api_key
# VITE_POSTHOG_HOST=https://app.posthog.com

# ============================================
# PUSH NOTIFICATIONS (ONESIGNAL)
# ============================================
# VITE_ONESIGNAL_APP_ID=your_onesignal_app_id

# ============================================
# SMS NOTIFICATIONS (HUBTEL) - Optional
# ============================================
# HUBTEL_CLIENT_ID=your_hubtel_client_id
# HUBTEL_CLIENT_SECRET=your_hubtel_secret

# ============================================
# ENVIRONMENT
# ============================================
NODE_ENV=development

# Supabase image transformation is a PAID add-on. Leave false unless the
# project plan includes it -- when disabled the /render/image endpoint returns
# 403 FeatureNotEnabled and every card/story falls back to a placeholder.
VITE_SUPABASE_IMAGE_TRANSFORM=false
